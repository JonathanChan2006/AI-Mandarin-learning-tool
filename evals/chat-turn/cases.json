[
  {"id": "mw-cat", "tags": ["error", "measure_word", "textbook"], "tutor": "你家有宠物吗？", "student": "我有一个猫。", "meaning": "I have a cat.", "expected": {"fix_any": ["一只猫", "只猫"], "card": "只", "why": "Animals like cats take the measure word 只, not 个."}},
  {"id": "mw-book", "tags": ["error", "measure_word", "textbook"], "tutor": "你的书包里有什么？", "student": "我有三个书。", "meaning": "I have three books.", "expected": {"fix_any": ["三本书", "本书"], "card": "本", "why": "Books take the measure word 本."}},
  {"id": "mw-missing", "tags": ["error", "measure_word", "textbook"], "tutor": "你有兄弟姐妹吗？", "student": "我有两哥哥。", "meaning": "I have two older brothers.", "expected": {"fix_any": ["两个哥哥"], "card": "个", "why": "A number needs a measure word before the noun: 两个哥哥."}},
  {"id": "num-liang", "tags": ["error", "wrong_word", "textbook"], "tutor": "你有几个哥哥？", "student": "我有二个哥哥。", "meaning": "I have two older brothers.", "expected": {"fix_any": ["两个哥哥", "两个"], "card": "两", "why": "Before a measure word, two is 两, not 二."}},
  {"id": "order-time", "tags": ["error", "word_order", "textbook"], "tutor": "你什么时候去学校？", "student": "我去学校明天。", "meaning": "I'm going to school tomorrow.", "expected": {"fix_any": ["明天去学校", "明天我去学校"], "why": "Time words go before the verb: 我明天去学校."}},
  {"id": "order-place", "tags": ["error", "word_order", "textbook"], "tutor": "你在哪儿吃午饭？", "student": "我吃午饭在家。", "meaning": "I eat lunch at home.", "expected": {"fix_any": ["在家吃午饭"], "why": "The place phrase goes before the verb: 我在家吃午饭."}},
  {"id": "order-ye", "tags": ["error", "word_order", "textbook"], "tutor": "我是老师。你呢？", "student": "也我是老师。", "meaning": "I'm a teacher too.", "expected": {"fix_any": ["我也是老师"], "why": "也 goes after the subject: 我也是老师."}},
  {"id": "order-dou", "tags": ["error", "word_order", "textbook"], "tutor": "你们是学生吗？", "student": "都我们是学生。", "meaning": "We are all students.", "expected": {"fix_any": ["我们都是学生"], "why": "都 goes after the subject: 我们都是学生."}},
  {"id": "order-daily", "tags": ["error", "word_order", "textbook"], "tutor": "你每天几点起床？", "student": "我七点起床每天。", "meaning": "I get up at seven every day.", "expected": {"fix_any": ["每天七点起床"], "why": "Time words go before the verb: 我每天七点起床."}},
  {"id": "neg-mei", "tags": ["error", "grammar", "textbook"], "tutor": "你有钱吗？", "student": "我不有钱。", "meaning": "I don't have money.", "expected": {"fix_any": ["没有钱", "没钱"], "card": "没有", "why": "有 is negated with 没, never 不."}},
  {"id": "shi-adj", "tags": ["error", "grammar", "textbook"], "tutor": "你妹妹怎么样？", "student": "她是漂亮。", "meaning": "She is pretty.", "expected": {"fix_any": ["她很漂亮", "很漂亮"], "fix_none": ["是漂亮"], "why": "Adjectives don't take 是; use 很: 她很漂亮."}},
  {"id": "ma-qword", "tags": ["error", "grammar", "textbook"], "tutor": "你想问我什么？", "student": "你是哪国人吗？", "meaning": "Which country are you from?", "expected": {"fix_any": ["你是哪国人"], "fix_none": ["哪国人吗"], "why": "A question word already makes it a question; drop 吗."}},
  {"id": "ma-anota", "tags": ["error", "grammar", "textbook"], "tutor": "你想问我什么？", "student": "你是不是老师吗？", "meaning": "Are you a teacher?", "expected": {"fix_any": ["你是不是老师", "你是老师吗"], "fix_none": ["是不是老师吗"], "why": "是不是 already asks the question; don't add 吗."}},
  {"id": "le-future", "tags": ["error", "grammar", "textbook"], "tutor": "你明天做什么？", "student": "我明天去了商店。", "meaning": "I'm going to the shop tomorrow.", "expected": {"fix_any": ["明天去商店", "明天要去商店", "明天会去商店"], "fix_none": ["去了商店"], "why": "了 marks a completed action, so it can't go with a future plan."}},
  {"id": "bi-hen", "tags": ["error", "grammar", "textbook"], "tutor": "你和你哥哥谁高？", "student": "我比他很高。", "meaning": "I'm taller than him.", "expected": {"fix_any": ["我比他高"], "fix_none": ["比他很高"], "why": "很 can't be used in a 比 comparison: 我比他高."}},
  {"id": "de-missing", "tags": ["error", "missing_particle", "textbook"], "tutor": "这是谁的书？", "student": "这是我书。", "meaning": "This is my book.", "expected": {"fix_any": ["我的书"], "card": "的", "why": "Possession of a thing needs 的: 我的书."}},
  {"id": "verb-missing", "tags": ["error", "grammar", "real-log"], "tutor": "你叫什么名字？", "student": "我Jonathan。", "meaning": "I'm Jonathan.", "expected": {"fix_any": ["我叫Jonathan", "叫Jonathan", "我是Jonathan"], "card": "叫", "why": "The sentence needs a verb: 我叫Jonathan. From your own mistake log."}},
  {"id": "wrong-eat", "tags": ["error", "wrong_word", "textbook"], "tutor": "你早上吃什么？", "student": "我喝面包。", "meaning": "I eat bread.", "expected": {"fix_any": ["吃面包"], "card": "吃", "why": "Bread is eaten (吃), not drunk (喝)."}},
  {"id": "wrong-char", "tags": ["error", "spelling", "textbook"], "tutor": "你是老师吗？", "student": "不是，我是学声。", "meaning": "No, I'm a student.", "expected": {"fix_any": ["学生"], "card": "学生", "why": "Wrong character: student is 学生, not 学声."}},
  {"id": "youdian", "tags": ["error", "wrong_word", "textbook"], "tutor": "你今天怎么样？", "student": "我一点儿累。", "meaning": "I'm a bit tired.", "expected": {"fix_any": ["有点儿累", "有点累"], "card": "有点儿", "why": "Before an adjective, 'a bit' is 有点儿, not 一点儿."}},
